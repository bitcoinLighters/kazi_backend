NODE_ENV=development
PORT=5000

# Set to false to skip the Atlas connection (uses the in-memory scaffold)
CONNECT_DATABASE=true

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Optional fallback variables if the URI is assembled by your team
MONGODB_USERNAME=<atlas-username>
MONGODB_PASSWORD=<atlas-password>
MONGO_URI_NOT_SRV=

# Authentication (set a long random value)
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Lightning/LND - use Polar locally during the hackathon
LND_REST_URL=http://127.0.0.1:8080
LND_MACAROON=
LND_TLS_CERT_PATH=

# LNbits Room wallet (backend only; never expose these to the frontend)
LNBITS_URL=https://your-room-lnbits-url
LNBITS_ADMIN_KEY=
LNBITS_INVOICE_KEY=
LNBITS_TIMEOUT_MS=15000
